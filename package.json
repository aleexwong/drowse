{
  "name": "drowse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drowse Layer 0 — remote MCP server for voice journal capture.",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "export": "node --experimental-strip-types src/export.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "typescript": "^7.0.2"
  }
}
