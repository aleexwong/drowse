rules_version = '2';

// Drowse stores daily voice journals — the most sensitive data in this project.
// Nothing reaches Firestore from a browser or phone: the only writer is the MCP
// server, which uses the Admin SDK and bypasses these rules. So the rules deny
// everything, and that denial is the whole point (PRD §11).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
