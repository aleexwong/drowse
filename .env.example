# --- Auth -------------------------------------------------------------------
# One long-lived token. Single user, no OAuth flow (PRD §11).
# Generate with: openssl rand -hex 32
DROWSE_TOKEN=replace-me-with-32-bytes-of-hex

# --- Capture defaults -------------------------------------------------------
# Used to work out "today" when the client does not send a date.
DROWSE_TIMEZONE=America/Vancouver
# Phase is a fact about the day, not an extraction result (PRD §4.1).
# Layer 0 runs entirely in baseline.
DROWSE_DEFAULT_PHASE=baseline

# --- Presets ----------------------------------------------------------------
# The drink catalogue the extractor and the quick-log path both run on.
# Unset uses the built-in defaults. Point it at your own file to override doses
# and add the words you actually use — see presets.example.json.
# A bad file is fatal at startup, never a silent fall back to the defaults.
# DROWSE_PRESETS=./presets.json

# --- Storage ----------------------------------------------------------------
# firestore | memory   (memory is for local smoke tests only — it loses data)
DROWSE_STORE=firestore
DROWSE_COLLECTION=transcripts
# Derived records (Layer 2 caffeine). Regenerable — safe to wipe and re-extract.
DROWSE_DERIVED_COLLECTION=derived
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIRESTORE_DATABASE_ID=(default)
# Only needed off Google infrastructure. On Cloud Run, leave unset.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Server -----------------------------------------------------------------
PORT=8080
